<%- include('partials/header', { title: 'Create Account' }) %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="form-card" style="max-width: 500px;">
    <h1 class="form-title" style="text-align: center;">Join LaunchForge</h1>
    <p class="form-subtitle" style="text-align: center;">Create an account to start launching products and joining the maker community.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST">
      <div class="form-group">
        <label class="form-label" for="username">Username *</label>
        <input type="text" id="username" name="username" class="form-control" placeholder="indie_hacker" required minlength="3">
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Email Address *</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="maker@example.com" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password *</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="At least 6 characters" required minlength="6">
      </div>

      <div class="form-group">
        <label class="form-label" for="bio">Bio</label>
        <input type="text" id="bio" name="bio" class="form-control" placeholder="e.g. Building micro-SaaS tools for creators">
      </div>

      <div class="form-group">
        <label class="form-label" for="avatar">Avatar Image URL (Optional)</label>
        <input type="url" id="avatar" name="avatar" class="form-control" placeholder="https://images.unsplash.com/...">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; margin-top: 0.5rem;">
        Create Free Account
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
      Already registered? <a href="/auth/login" style="color: var(--accent-blue); font-weight: 700;">Sign in</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
