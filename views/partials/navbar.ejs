<header class="navbar">
  <div class="container nav-container">
    <a href="/" class="brand-logo">
      <div class="logo-badge"><i class="fa-solid fa-rocket"></i></div>
      <span class="logo-text">LaunchForge</span>
    </a>

    <nav class="nav-links">
      <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Explore</a>
      <a href="/leaderboard" class="nav-link <%= currentPath === '/leaderboard' ? 'active' : '' %>">Leaderboard</a>
      <a href="/docs" class="nav-link <%= currentPath === '/docs' ? 'active' : '' %>" style="color: #38BDF8;">
        <i class="fa-solid fa-graduation-cap"></i> Viva Code Guide
      </a>
      
      <% if (currentUser) { %>
        <a href="/products/new" class="btn btn-primary">
          <i class="fa-solid fa-plus"></i> Submit Product
        </a>
        <div class="user-menu">
          <a href="/auth/profile" title="Profile">
            <img src="<%= currentUser.avatar %>" alt="<%= currentUser.username %>" class="user-avatar">
          </a>
          <a href="/auth/logout" class="btn btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">
            Logout
          </a>
        </div>
      <% } else { %>
        <a href="/auth/login" class="nav-link">Sign In</a>
        <a href="/auth/register" class="btn btn-primary">
          Get Started
        </a>
      <% } %>
    </nav>
  </div>
</header>
