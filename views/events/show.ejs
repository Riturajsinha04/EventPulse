<%- include('../partials/header', { title: event.title }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <!-- Event Hero Header -->
  <div class="event-banner" style="background-image: linear-gradient(180deg, rgba(15, 23, 42, 0.7) 0%, rgba(15, 23, 42, 0.95) 100%), url('<%= event.image %>');">
    <div class="container hero-event-container">
      <div class="event-hero-header">
        <div class="event-tags">
          <span class="category-badge"><%= event.category %></span>
          <span class="location-badge location-<%= event.locationType.toLowerCase() %>">
            <i class="fa-solid <%= event.locationType === 'Online' ? 'fa-video' : 'fa-location-dot' %>"></i>
            <%= event.locationType %> Event
          </span>
          <% if (event.featured) { %>
            <span class="badge-featured"><i class="fa-solid fa-star"></i> Featured Flagship</span>
          <% } %>
        </div>

        <h1 class="event-page-title"><%= event.title %></h1>
        <p class="event-page-tagline"><%= event.tagline %></p>

        <div class="event-quick-info">
          <div class="info-pill">
            <i class="fa-regular fa-calendar-check text-accent"></i>
            <span><%= new Date(event.date).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %></span>
          </div>
          <div class="info-pill">
            <i class="fa-regular fa-clock text-accent"></i>
            <span><%= event.time %></span>
          </div>
          <div class="info-pill">
            <i class="fa-solid fa-building text-accent"></i>
            <span><%= event.venue.city %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container py-4">
    <!-- Flash Messages -->
    <% if (error) { %>
      <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i> <%= success %>
      </div>
    <% } %>

    <div class="event-layout-grid">
      <!-- Main Content Left Side -->
      <div class="event-main-content">
        <!-- Overview & Description -->
        <div class="card-box">
          <h2 class="card-box-title"><i class="fa-solid fa-align-left text-accent"></i> About This Conference</h2>
          <div class="event-description-text">
            <p><%= event.description %></p>
          </div>
        </div>

        <!-- Speaker Lineup -->
        <div class="card-box mt-4">
          <h2 class="card-box-title"><i class="fa-solid fa-microphone text-accent"></i> Keynote Speaker Lineup</h2>
          <% if (event.speakers && event.speakers.length > 0) { %>
            <div class="speakers-grid">
              <% event.speakers.forEach(speaker => { %>
                <div class="speaker-card">
                  <img src="<%= speaker.photo %>" alt="<%= speaker.name %>" class="speaker-photo">
                  <div class="speaker-info">
                    <h4 class="speaker-name"><%= speaker.name %></h4>
                    <span class="speaker-title"><%= speaker.title %> &bull; <strong><%= speaker.company %></strong></span>
                    <div class="speaker-topic">
                      <i class="fa-solid fa-message"></i> Keynote: "<%= speaker.topic %>"
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-dim">Keynote speaker schedule and session topics will be announced shortly by the organizer.</p>
          <% } %>
        </div>

        <!-- Venue & Stream Access -->
        <div class="card-box mt-4">
          <h2 class="card-box-title"><i class="fa-solid fa-map-location-dot text-accent"></i> Location &amp; Venue Details</h2>
          <div class="venue-info-box">
            <div class="venue-detail">
              <i class="fa-solid fa-building venue-icon"></i>
              <div>
                <strong><%= event.venue.name %></strong>
                <p><%= event.venue.address %>, <%= event.venue.city %></p>
              </div>
            </div>

            <% if (event.locationType !== 'In-Person' && event.venue.onlineUrl) { %>
              <div class="venue-detail mt-3">
                <i class="fa-solid fa-video venue-icon text-accent"></i>
                <div>
                  <strong>Live Stream Access</strong>
                  <p><a href="<%= event.venue.onlineUrl %>" target="_blank" class="stream-link"><%= event.venue.onlineUrl %> <i class="fa-solid fa-external-link-alt"></i></a></p>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Organizer Profile Box -->
        <div class="card-box mt-4">
          <h2 class="card-box-title"><i class="fa-solid fa-user-shield text-accent"></i> Event Host &amp; Organizer</h2>
          <div class="organizer-profile-row">
            <img src="<%= event.organizer ? event.organizer.avatar : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80' %>" alt="Organizer" class="organizer-avatar-lg">
            <div class="organizer-bio-info">
              <h3><%= event.organizer ? event.organizer.name : 'Tech Organizer' %></h3>
              <p class="organizer-company"><i class="fa-solid fa-briefcase"></i> <%= event.organizer ? event.organizer.company : 'Tech Community' %></p>
              <p class="organizer-bio"><%= event.organizer ? event.organizer.bio : 'Organizer of community developer meetups.' %></p>
            </div>
          </div>
        </div>

        <!-- Discussion & Q&A Forum -->
        <div class="card-box mt-4" id="discussion">
          <h2 class="card-box-title"><i class="fa-solid fa-comments text-accent"></i> Attendee Q&amp;A &amp; Discussion (<%= comments.length %>)</h2>

          <% if (currentUser) { %>
            <form action="/events/<%= event._id %>/comments" method="POST" class="comment-form">
              <div class="form-group">
                <textarea name="content" rows="3" placeholder="Ask a question or share excitement about this meetup..." class="form-control" required></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Post Comment</button>
            </form>
          <% } else { %>
            <div class="auth-prompt-box">
              <p><a href="/auth/login">Sign in</a> to join the Q&amp;A discussion or contact the organizers.</p>
            </div>
          <% } %>

          <div class="comments-list mt-4">
            <% if (comments && comments.length > 0) { %>
              <% comments.forEach(comment => { %>
                <div class="comment-card">
                  <img src="<%= comment.author ? comment.author.avatar : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80' %>" class="comment-avatar" alt="Author">
                  <div class="comment-body">
                    <div class="comment-header">
                      <span class="comment-author-name"><%= comment.author ? comment.author.name : 'Attendee' %></span>
                      <span class="comment-company">&bull; <%= comment.author ? comment.author.company : 'Tech Enthusiast' %></span>
                      <span class="comment-time"><%= new Date(comment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                    </div>
                    <p class="comment-text"><%= comment.content %></p>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <p class="text-dim mt-3">No discussion questions posted yet. Be the first to start the conversation!</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Right Sidebar: Ticket Purchase / RSVP Widget -->
      <div class="event-sidebar">
        <div class="ticket-widget-card sticky-widget">
          <div class="ticket-header">
            <span class="ticket-price">
              <%= event.ticketPrice === 0 ? 'FREE PASS' : '$' + event.ticketPrice %>
            </span>
            <span class="ticket-status-pill <%= event.rsvps.length >= event.capacity ? 'status-soldout' : 'status-available' %>">
              <%= event.rsvps.length >= event.capacity ? 'SOLD OUT' : 'TICKETS AVAILABLE' %>
            </span>
          </div>

          <div class="ticket-meta-list">
            <div class="meta-item">
              <i class="fa-solid fa-users text-accent"></i>
              <span><strong><%= event.rsvps.length %></strong> / <%= event.capacity %> attendees registered</span>
            </div>
            <div class="capacity-bar-wrap">
              <div class="capacity-bar-fill" style="width: <%= Math.min(100, Math.round((event.rsvps.length / event.capacity) * 100)) %>%;"></div>
            </div>
            <div class="meta-item mt-2">
              <i class="fa-regular fa-id-badge text-accent"></i>
              <span>Digital Ticket Pass Included</span>
            </div>
          </div>

          <div class="ticket-actions mt-4">
            <% if (currentUser) { %>
              <form action="/events/<%= event._id %>/rsvp" method="POST">
                <% if (isRSVPed) { %>
                  <button type="submit" class="btn btn-secondary btn-block btn-rsvp-cancel">
                    <i class="fa-solid fa-ticket-simple"></i> Cancel Ticket / RSVP
                  </button>
                  <p class="ticket-confirmation-note mt-2"><i class="fa-solid fa-check-circle text-success"></i> You are registered for this event! View pass in <a href="/events/my-tickets">My Tickets</a>.</p>
                <% } else if (event.rsvps.length >= event.capacity) { %>
                  <button type="button" class="btn btn-secondary btn-block" disabled>
                    Capacity Reached
                  </button>
                <% } else { %>
                  <button type="submit" class="btn btn-primary btn-block btn-rsvp-claim">
                    <i class="fa-solid fa-bolt"></i> Claim Ticket / RSVP Now
                  </button>
                <% } %>
              </form>
            <% } else { %>
              <a href="/auth/login" class="btn btn-primary btn-block">
                Sign In to Reserve Ticket
              </a>
            <% } %>

            <% if (isOrganizer) { %>
              <div class="organizer-controls mt-4">
                <hr class="divider">
                <span class="organizer-label"><i class="fa-solid fa-gear"></i> Organizer Options:</span>
                <div class="organizer-btn-group mt-2">
                  <a href="/events/<%= event._id %>/edit" class="btn btn-secondary btn-sm flex-1">
                    <i class="fa-solid fa-pen"></i> Edit Event
                  </a>
                  <form action="/events/<%= event._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                    <button type="submit" class="btn btn-danger btn-sm">
                      <i class="fa-solid fa-trash"></i> Delete
                    </button>
                  </form>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
