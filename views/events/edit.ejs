<%- include('../partials/header', { title: 'Edit Event - ' + event.title }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container py-4">
    <div class="form-card-container">
      <div class="form-header">
        <h1 class="page-title"><i class="fa-solid fa-pen text-accent"></i> Edit Event Details</h1>
        <p class="page-subtitle">Update information for "<%= event.title %>"</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error">
          <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
        </div>
      <% } %>

      <form action="/events/<%= event._id %>?_method=PUT" method="POST" class="event-form">
        <div class="form-section">
          <div class="form-group">
            <label for="title">Event Title</label>
            <input type="text" id="title" name="title" value="<%= event.title %>" class="form-control" required>
          </div>

          <div class="form-group">
            <label for="tagline">Short Tagline</label>
            <input type="text" id="tagline" name="tagline" value="<%= event.tagline %>" class="form-control" required>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="category">Category</label>
              <select id="category" name="category" class="form-control" required>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat %>" <%= event.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }); %>
              </select>
            </div>

            <div class="form-group col-md-6">
              <label for="locationType">Format</label>
              <select id="locationType" name="locationType" class="form-control" required>
                <option value="In-Person" <%= event.locationType === 'In-Person' ? 'selected' : '' %>>In-Person</option>
                <option value="Online" <%= event.locationType === 'Online' ? 'selected' : '' %>>Online Virtual Stream</option>
                <option value="Hybrid" <%= event.locationType === 'Hybrid' ? 'selected' : '' %>>Hybrid</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="description">Conference Description</label>
            <textarea id="description" name="description" rows="5" class="form-control" required><%= event.description %></textarea>
          </div>
        </div>

        <div class="form-section mt-4">
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="time">Time Slot</label>
              <input type="text" id="time" name="time" value="<%= event.time %>" class="form-control">
            </div>
            <div class="form-group col-md-6">
              <label for="capacity">Capacity</label>
              <input type="number" id="capacity" name="capacity" value="<%= event.capacity %>" class="form-control">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-4">
              <label for="venueName">Venue Name</label>
              <input type="text" id="venueName" name="venueName" value="<%= event.venue ? event.venue.name : '' %>" class="form-control">
            </div>
            <div class="form-group col-md-4">
              <label for="venueCity">City</label>
              <input type="text" id="venueCity" name="venueCity" value="<%= event.venue ? event.venue.city : '' %>" class="form-control">
            </div>
            <div class="form-group col-md-4">
              <label for="ticketPrice">Price ($ USD)</label>
              <input type="number" step="0.01" id="ticketPrice" name="ticketPrice" value="<%= event.ticketPrice %>" class="form-control">
            </div>
          </div>
        </div>

        <div class="form-actions mt-4">
          <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
          <a href="/events/<%= event._id %>" class="btn btn-secondary btn-lg">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
