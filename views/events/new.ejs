<%- include('../partials/header', { title: 'Host New Event' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container py-4">
    <div class="form-card-container">
      <div class="form-header">
        <h1 class="page-title"><i class="fa-solid fa-calendar-plus text-accent"></i> Host a Tech Event</h1>
        <p class="page-subtitle">Publish your developer meetup, keynote conference, or virtual workshop</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error">
          <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
        </div>
      <% } %>

      <form action="/events" method="POST" class="event-form">
        <!-- Section 1: Basic Event Details -->
        <div class="form-section">
          <h3 class="form-section-title"><i class="fa-solid fa-circle-info text-accent"></i> 1. Event Information</h3>
          
          <div class="form-group">
            <label for="title">Event Title *</label>
            <input type="text" id="title" name="title" placeholder="e.g. Global AI & LLM Summit 2026" class="form-control" required>
          </div>

          <div class="form-group">
            <label for="tagline">Short Tagline *</label>
            <input type="text" id="tagline" name="tagline" placeholder="e.g. Building Next-Gen Intelligent Applications with Gemini & PyTorch" class="form-control" required>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="category">Domain Category *</label>
              <select id="category" name="category" class="form-control" required>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat %>"><%= cat %></option>
                <% }); %>
              </select>
            </div>

            <div class="form-group col-md-6">
              <label for="locationType">Format / Location Type *</label>
              <select id="locationType" name="locationType" class="form-control" required>
                <option value="In-Person">In-Person</option>
                <option value="Online">Online Virtual Stream</option>
                <option value="Hybrid">Hybrid (In-Person + Online)</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="description">Full Conference Description *</label>
            <textarea id="description" name="description" rows="5" placeholder="Detailed overview of what attendees will learn, agenda highlights, networking sessions..." class="form-control" required></textarea>
          </div>
        </div>

        <!-- Section 2: Date, Time & Venue -->
        <div class="form-section mt-4">
          <h3 class="form-section-title"><i class="fa-solid fa-clock text-accent"></i> 2. Date, Venue &amp; Ticketing</h3>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="date">Event Date *</label>
              <input type="date" id="date" name="date" class="form-control" required>
            </div>

            <div class="form-group col-md-6">
              <label for="time">Time Slot *</label>
              <input type="text" id="time" name="time" placeholder="e.g. 09:00 AM - 05:00 PM EST" class="form-control" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-4">
              <label for="venueName">Venue Name</label>
              <input type="text" id="venueName" name="venueName" placeholder="e.g. Tech Convention Hall" class="form-control">
            </div>

            <div class="form-group col-md-4">
              <label for="venueCity">City &amp; State / Country</label>
              <input type="text" id="venueCity" name="venueCity" placeholder="e.g. San Francisco, CA" class="form-control">
            </div>

            <div class="form-group col-md-4">
              <label for="onlineUrl">Live Stream Link (for Virtual/Hybrid)</label>
              <input type="url" id="onlineUrl" name="onlineUrl" placeholder="https://eventpulse.live/stream" class="form-control">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="capacity">Total Ticket Capacity</label>
              <input type="number" id="capacity" name="capacity" value="250" class="form-control">
            </div>

            <div class="form-group col-md-6">
              <label for="ticketPrice">Ticket Price ($ USD - 0 for Free Pass)</label>
              <input type="number" step="0.01" id="ticketPrice" name="ticketPrice" value="0" class="form-control">
            </div>
          </div>

          <div class="form-group">
            <label for="image">Banner Image URL</label>
            <input type="url" id="image" name="image" placeholder="https://images.unsplash.com/photo-1540575467063-178a50c2df87" class="form-control">
          </div>
        </div>

        <!-- Section 3: Keynote Speaker -->
        <div class="form-section mt-4">
          <h3 class="form-section-title"><i class="fa-solid fa-microphone text-accent"></i> 3. Featured Keynote Speaker</h3>
          <div class="form-row">
            <div class="form-group col-md-6">
              <label>Speaker Name</label>
              <input type="text" name="speakerNames" placeholder="Dr. Elena Rostova" class="form-control">
            </div>
            <div class="form-group col-md-6">
              <label>Title &amp; Company</label>
              <input type="text" name="speakerTitles" placeholder="VP of AI Research" class="form-control">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group col-md-6">
              <label>Speaker Company / Org</label>
              <input type="text" name="speakerCompanies" placeholder="DeepMind Labs" class="form-control">
            </div>
            <div class="form-group col-md-6">
              <label>Keynote Talk Topic</label>
              <input type="text" name="speakerTopics" placeholder="Scaling Autonomous Agents in 2026" class="form-control">
            </div>
          </div>
        </div>

        <div class="form-actions mt-4">
          <button type="submit" class="btn btn-primary btn-lg">Publish Event &amp; Open Registration</button>
          <a href="/events" class="btn btn-secondary btn-lg">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
