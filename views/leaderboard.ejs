<%- include('partials/header', { title: 'Leaderboard & Top Makers' }) %>
<%- include('partials/navbar') %>

<main class="container">
  <section class="hero" style="padding-bottom: 1.5rem;">
    <h1 class="hero-title">🏆 Product Leaderboard</h1>
    <p class="hero-subtitle">Top upvoted products and leading indie hackers on LaunchForge.</p>
  </section>

  <div class="form-card" style="max-width: 100%; margin-top: 1rem;">
    <table class="leaderboard-table">
      <thead>
        <tr>
          <th>Rank</th>
          <th>Product</th>
          <th>Category</th>
          <th>Maker</th>
          <th>Upvotes</th>
        </tr>
      </thead>
      <tbody>
        <% if (topProducts && topProducts.length > 0) { %>
          <% topProducts.forEach((product, index) => { %>
            <tr>
              <td style="font-weight: 800; font-size: 1.1rem;">
                <% if (index === 0) { %> 🥇 <% } else if (index === 1) { %> 🥈 <% } else if (index === 2) { %> 🥉 <% } else { %> #<%= index + 1 %> <% } %>
              </td>
              <td>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                  <img src="<%= product.imageUrl %>" alt="<%= product.title %>" style="width: 40px; height: 40px; border-radius: var(--radius-sm); object-fit: cover;">
                  <div>
                    <a href="/products/<%= product._id %>" style="font-weight: 700; color: var(--text-main);"><%= product.title %></a>
                    <div style="font-size: 0.8rem; color: var(--text-muted);"><%= product.tagline %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="tag-badge" style="background: rgba(99, 102, 241, 0.15); color: #818CF8;"><%= product.category %></span>
              </td>
              <td>
                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
                  <img src="<%= product.maker.avatar %>" alt="<%= product.maker.username %>" style="width: 24px; height: 24px; border-radius: 50%;">
                  <span><%= product.maker.username %></span>
                </div>
              </td>
              <td style="font-weight: 800; color: var(--accent-pink);">
                <i class="fa-solid fa-caret-up"></i> <%= product.upvotes ? product.upvotes.length : 0 %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align: center; color: var(--text-muted);">No products on leaderboard yet.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>

<%- include('partials/footer') %>
