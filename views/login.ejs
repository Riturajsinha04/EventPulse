<%- include('partials/header', { title: 'Sign In' }) %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="form-card" style="max-width: 480px;">
    <h1 class="form-title" style="text-align: center;">Welcome Back</h1>
    <p class="form-subtitle" style="text-align: center;">Sign in to upvote, comment, and launch products.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
      </div>
    <% } %>

    <form action="/auth/login" method="POST">
      <div class="form-group">
        <label class="form-label" for="email">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="maker@example.com" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; margin-top: 0.5rem;">
        Sign In
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
      Don't have an account? <a href="/auth/register" style="color: var(--accent-blue); font-weight: 700;">Sign up</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
