<%- include('partials/header', { title: 'Discover & Launch Great Products' }) %>
<%- include('partials/navbar') %>

<main class="container">
  <section class="hero">
    <h1 class="hero-title">The Best New Products, <br><span class="logo-text">Every Single Day</span></h1>
    <p class="hero-subtitle">Discover, upvote, and launch tech innovations built by makers worldwide. Powered by SSR with EJS and MongoDB Atlas.</p>

    <!-- Search Form -->
    <form action="/" method="GET" class="search-form">
      <i class="fa-solid fa-magnifying-glass search-icon"></i>
      <input type="text" name="search" class="search-input" placeholder="Search products, taglines, or tags..." value="<%= searchQuery %>">
      <% if (selectedCategory !== 'All') { %>
        <input type="hidden" name="category" value="<%= selectedCategory %>">
      <% } %>
    </form>
  </section>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" style="max-width: 600px; margin: 1rem auto; text-align: center;">
      <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
    </div>
  <% } %>

  <!-- Filter & Sort Bar -->
  <div class="filter-bar">
    <div class="category-chips">
      <% categories.forEach(cat => { %>
        <div class="chip <%= selectedCategory === cat ? 'active' : '' %>" data-category="<%= cat %>">
          <%= cat %>
        </div>
      <% }) %>
    </div>

    <div class="sort-wrapper">
      <select id="sortSelect" class="sort-select">
        <option value="trending" <%= selectedSort === 'trending' ? 'selected' : '' %>>🔥 Trending</option>
        <option value="newest" <%= selectedSort === 'newest' ? 'selected' : '' %>>✨ Newest First</option>
      </select>
    </div>
  </div>

  <!-- Products Grid -->
  <div class="products-grid">
    <% if (products && products.length > 0) { %>
      <% products.forEach(product => { %>
        <article class="product-card">
          <div class="card-header">
            <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="product-thumb" onerror="this.src='https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=150&q=80'">
            <div class="product-info">
              <a href="/products/<%= product._id %>" class="product-title"><%= product.title %></a>
              <p class="product-tagline"><%= product.tagline %></p>
            </div>
          </div>

          <div class="card-tags">
            <span class="tag-badge" style="background: rgba(99, 102, 241, 0.15); color: #818CF8;"><%= product.category %></span>
            <% if (product.tags && product.tags.length > 0) { %>
              <% product.tags.slice(0, 3).forEach(tag => { %>
                <span class="tag-badge">#<%= tag %></span>
              <% }) %>
            <% } %>
          </div>

          <div class="card-footer">
            <div class="maker-badge">
              <% if (product.maker) { %>
                <img src="<%= product.maker.avatar %>" alt="<%= product.maker.username %>" class="maker-avatar">
                <span><%= product.maker.username %></span>
              <% } else { %>
                <span>Anonymous Maker</span>
              <% } %>
            </div>

            <form action="/products/<%= product._id %>/upvote" method="POST">
              <% const hasUpvoted = currentUser && product.upvotes && product.upvotes.some(id => id.toString() === currentUser.id.toString()); %>
              <button type="submit" class="upvote-btn <%= hasUpvoted ? 'has-upvoted' : '' %>">
                <div class="triangle-icon"></div>
                <span><%= product.upvotes ? product.upvotes.length : 0 %></span>
              </button>
            </form>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
        <i class="fa-solid fa-box-open" style="font-size: 3rem; color: var(--text-dim); margin-bottom: 1rem;"></i>
        <h3 style="font-size: 1.3rem;">No products found</h3>
        <p style="color: var(--text-muted); margin-top: 0.5rem;">Be the first indie hacker to launch a product in this category!</p>
        <a href="/products/new" class="btn btn-primary" style="margin-top: 1.5rem;">
          <i class="fa-solid fa-plus"></i> Submit a Product
        </a>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
