<%- include('partials/header', { title: 'Tech Meetups & Keynote Conferences' }) %>
<%- include('partials/navbar') %>

<main class="main-content">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="hero-badge"><i class="fa-solid fa-fire text-accent"></i> Premier Developer Events 2026</span>
        <h1 class="hero-title">Discover World-Class Tech Conferences &amp; Meetups</h1>
        <p class="hero-subtitle">
          Connect with industry leaders, learn from keynote speakers, and claim tickets to virtual and in-person developer summits around the globe.
        </p>

        <!-- Search Bar -->
        <form action="/events" method="GET" class="hero-search-form">
          <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" name="search" placeholder="Search by topic, conference, city, or AI..." class="search-input">
          </div>
          <button type="submit" class="btn btn-primary search-btn">
            Find Events
          </button>
        </form>

        <!-- Quick Stats -->
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num"><%= stats.events %>+</span>
            <span class="stat-label">Active Events</span>
          </div>
          <div class="stat-item">
            <span class="stat-num"><%= stats.organizers %>+</span>
            <span class="stat-label">Tech Organizers</span>
          </div>
          <div class="stat-item">
            <span class="stat-num"><%= stats.attendees.toLocaleString() %>+</span>
            <span class="stat-label">Tickets Issued</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Banner Alerts -->
  <div class="container">
    <% if (error) { %>
      <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i> <%= success %>
      </div>
    <% } %>
  </div>

  <!-- Featured Keynote Conferences -->
  <% if (featuredEvents && featuredEvents.length > 0) { %>
    <section class="featured-section">
      <div class="container">
        <div class="section-header">
          <div>
            <h2 class="section-title"><i class="fa-solid fa-star text-accent"></i> Featured Keynote Summits</h2>
            <p class="section-subtitle">Top flagship tech conferences with renowned global speakers</p>
          </div>
          <a href="/events" class="btn-text">View All <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        <div class="featured-grid">
          <% featuredEvents.forEach(event => { %>
            <div class="featured-card">
              <div class="featured-img-wrap">
                <img src="<%= event.image %>" alt="<%= event.title %>" class="featured-img">
                <span class="category-badge"><%= event.category %></span>
                <span class="location-badge location-<%= event.locationType.toLowerCase() %>">
                  <i class="fa-solid <%= event.locationType === 'Online' ? 'fa-video' : 'fa-location-dot' %>"></i>
                  <%= event.locationType %>
                </span>
              </div>
              <div class="featured-card-body">
                <div class="event-date-row">
                  <i class="fa-regular fa-calendar text-accent"></i>
                  <span><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                  <span class="dot-separator">&bull;</span>
                  <span><%= event.venue.city %></span>
                </div>
                <h3 class="event-card-title">
                  <a href="/events/<%= event._id %>"><%= event.title %></a>
                </h3>
                <p class="event-tagline"><%= event.tagline %></p>

                <div class="event-card-footer">
                  <div class="organizer-info">
                    <img src="<%= event.organizer ? event.organizer.avatar : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80' %>" class="organizer-thumb" alt="Organizer">
                    <span class="organizer-name"><%= event.organizer ? event.organizer.name : 'Tech Summit' %></span>
                  </div>
                  <a href="/events/<%= event._id %>" class="btn btn-secondary btn-sm">
                    Claim Ticket &rarr;
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Categories Pill Bar -->
  <section class="categories-section">
    <div class="container">
      <h3 class="categories-title">Browse by Tech Domain</h3>
      <div class="category-pills">
        <% categories.forEach(cat => { %>
          <a href="/events?category=<%= cat %>" class="cat-pill">
            <%= cat %>
          </a>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Upcoming Events Grid -->
  <section class="events-directory-section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title"><i class="fa-solid fa-calendar-days text-accent"></i> Upcoming Tech Meetups</h2>
          <p class="section-subtitle">Discover upcoming community meetups and regional workshops</p>
        </div>
        <a href="/events" class="btn btn-secondary">
          Explore All Events
        </a>
      </div>

      <div class="events-grid">
        <% if (upcomingEvents && upcomingEvents.length > 0) { %>
          <% upcomingEvents.forEach(event => { %>
            <div class="event-card">
              <div class="card-image-wrap">
                <img src="<%= event.image %>" alt="<%= event.title %>" class="event-card-img">
                <span class="price-badge <%= event.ticketPrice === 0 ? 'free-badge' : 'paid-badge' %>">
                  <%= event.ticketPrice === 0 ? 'FREE PASS' : '$' + event.ticketPrice %>
                </span>
              </div>
              <div class="card-content">
                <div class="card-meta">
                  <span class="category-pill"><%= event.category %></span>
                  <span class="rsvp-counter"><i class="fa-solid fa-users"></i> <%= event.rsvps.length %> Registered</span>
                </div>

                <h3 class="card-title">
                  <a href="/events/<%= event._id %>"><%= event.title %></a>
                </h3>
                <p class="card-tagline"><%= event.tagline %></p>

                <div class="card-details">
                  <div class="detail-row">
                    <i class="fa-regular fa-clock"></i>
                    <span><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> &bull; <%= event.time %></span>
                  </div>
                  <div class="detail-row">
                    <i class="fa-solid fa-building"></i>
                    <span><%= event.venue.name %> (<%= event.venue.city %>)</span>
                  </div>
                </div>

                <div class="card-footer">
                  <a href="/events/<%= event._id %>" class="btn btn-primary btn-block">
                    View Lineup &amp; RSVP
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state">
            <i class="fa-solid fa-calendar-xmark empty-icon"></i>
            <h3>No events listed yet</h3>
            <p>Be the first organizer to host a tech event on EventPulse!</p>
            <a href="/events/new" class="btn btn-primary mt-2">Host an Event</a>
          </div>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
