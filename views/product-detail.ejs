<%- include('partials/header', { title: product.title }) %>
<%- include('partials/navbar') %>

<main class="container">
  <div style="margin-top: 1.5rem;">
    <a href="/" style="color: var(--text-muted); font-size: 0.9rem; font-weight: 600;">
      <i class="fa-solid fa-arrow-left"></i> Back to Products
    </a>
  </div>

  <!-- Details Hero -->
  <section class="details-hero">
    <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="details-thumb" onerror="this.src='https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=300&q=80'">
    <div class="details-info">
      <h1 class="details-title"><%= product.title %></h1>
      <p class="details-tagline"><%= product.tagline %></p>
      
      <div class="card-tags" style="margin-bottom: 1.5rem;">
        <span class="tag-badge" style="background: rgba(99, 102, 241, 0.2); color: #A5B4FC; font-size: 0.85rem; padding: 0.3rem 0.8rem;"><%= product.category %></span>
        <% if (product.tags) { %>
          <% product.tags.forEach(tag => { %>
            <span class="tag-badge" style="font-size: 0.85rem; padding: 0.3rem 0.8rem;">#<%= tag %></span>
          <% }) %>
        <% } %>
      </div>

      <div class="details-actions">
        <a href="<%= product.demoUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> Visit Website / Launch Demo
        </a>

        <form action="/products/<%= product._id %>/upvote" method="POST">
          <% const hasUpvoted = currentUser && product.upvotes && product.upvotes.some(id => id.toString() === currentUser.id.toString()); %>
          <button type="submit" class="btn <%= hasUpvoted ? 'btn-primary' : 'btn-secondary' %>">
            <i class="fa-solid fa-caret-up"></i>
            <%= hasUpvoted ? 'Upvoted' : 'Upvote' %> (<%= product.upvotes ? product.upvotes.length : 0 %>)
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Product Description & Maker Info -->
  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 3rem;">
    <div class="form-card" style="margin: 0; max-width: 100%;">
      <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem;">About <%= product.title %></h2>
      <div style="color: var(--text-muted); line-height: 1.7; white-space: pre-line; font-size: 1rem;">
        <%= product.description %>
      </div>
    </div>

    <div class="form-card" style="margin: 0; max-width: 100%; height: fit-content;">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem;">Launched By</h3>
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
        <img src="<%= product.maker.avatar %>" alt="<%= product.maker.username %>" style="width: 50px; height: 50px; border-radius: 50%; border: 2px solid var(--accent-blue);">
        <div>
          <h4 style="font-size: 1.1rem; font-weight: 700;"><%= product.maker.username %></h4>
          <p style="font-size: 0.85rem; color: var(--text-muted);"><%= product.maker.bio %></p>
        </div>
      </div>
      <p style="font-size: 0.8rem; color: var(--text-dim);">
        <i class="fa-regular fa-calendar"></i> Launched on <%= new Date(product.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
      </p>
    </div>
  </div>

  <!-- Discussion & Feedback Section -->
  <section class="comment-section">
    <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem;">
      <i class="fa-regular fa-comments"></i> Discussion &amp; Maker Feedback (<%= comments ? comments.length : 0 %>)
    </h2>

    <!-- Post Comment Form -->
    <% if (currentUser) { %>
      <form action="/products/<%= product._id %>/comment" method="POST" style="margin-bottom: 2rem;">
        <div class="form-group">
          <textarea name="content" class="form-control" placeholder="Ask a question or leave feedback for the maker..." rows="3" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">
          <i class="fa-solid fa-paper-plane"></i> Post Comment
        </button>
      </form>
    <% } else { %>
      <div style="background: rgba(255, 255, 255, 0.04); border: 1px dashed var(--border-color); padding: 1.25rem; border-radius: var(--radius-md); text-align: center; margin-bottom: 2rem;">
        <p style="color: var(--text-muted);">Please <a href="/auth/login" style="color: var(--accent-blue); font-weight: 700;">sign in</a> to join the conversation and leave feedback.</p>
      </div>
    <% } %>

    <!-- Comments List -->
    <% if (comments && comments.length > 0) { %>
      <% comments.forEach(comment => { %>
        <div class="comment-card">
          <div class="comment-author">
            <img src="<%= comment.author.avatar %>" alt="<%= comment.author.username %>" style="width: 28px; height: 28px; border-radius: 50%;">
            <span><%= comment.author.username %></span>
            <span style="color: var(--text-dim); font-size: 0.75rem; font-weight: 400;">
              &bull; <%= new Date(comment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
            </span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5;"><%= comment.content %></p>
        </div>
      <% }) %>
    <% } else { %>
      <p style="color: var(--text-dim); font-style: italic;">No comments yet. Be the first to start the discussion!</p>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
